% matins.sty — page design for the bilingual Matins readings (LuaLaTeX).
% Content is generated by matins/tools/build_latex.py; adjust the look here.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{matins}[2026/10/08 Matins readings page design]

% ---- Page: 6 x 9 in, two-sided --------------------------------------------
\RequirePackage[paperwidth=6in, paperheight=9in, twoside,
  inner=0.72in, outer=0.55in, top=0.72in, bottom=0.7in,
  headheight=12pt, headsep=0.16in, footskip=0.3in]{geometry}

% ---- Type -------------------------------------------------------------------
\RequirePackage{fontspec}
% HarfBuzz places combining accents (œ́) correctly; old-style figures suit the page.
\setmainfont{EB Garamond}[Renderer=HarfBuzz, Numbers=OldStyle, Ligatures=TeX]
\RequirePackage[english, ecclesiasticallatin]{babel}  % liturgical Latin hyphenation
\RequirePackage[protrusion=true, expansion=true]{microtype}
\RequirePackage{xcolor}
\definecolor{rubric}{HTML}{9B1C1C}

\newcommand\BodySize{\fontsize{9.6pt}{11.6pt}\selectfont}
\setlength{\parindent}{0.9em}
\setlength{\parskip}{0pt}
\tolerance=900
\emergencystretch=1.2em
\hyphenpenalty=40
\clubpenalty=10000
\widowpenalty=10000

% ---- Parallel columns --------------------------------------------------------
\RequirePackage{paracol}
\setlength{\columnsep}{0.2in}
\setlength{\columnseprule}{0.3pt}
\colseprulecolor{rubric!35}
\globalcounter*

% English runs about a fifth longer than Latin. Two knobs keep the columns
% level: the Latin column's share of the width, and the English type size.
\providecommand\LatinShare{0.48}
\providecommand\ENsize{\fontsize{9.2pt}{11.2pt}\selectfont}
\AtBeginDocument{\columnratio{\LatinShare}}
\newcommand\LA{\selectlanguage{ecclesiasticallatin}\BodySize}
\newcommand\EN{\selectlanguage{english}\ENsize}

% ---- Running heads: Latin title on the left page, English on the right -------
% paracol does not carry \markboth marks, so each \Office writes its page to the
% .aux file and the head shows the last office begun on or before the page
% (a second LaTeX run, which latexmk does, puts them in place).
\RequirePackage{fancyhdr}
\RequirePackage{emptypage}  % blank pages before part titles stay blank
\newcommand\OfficeStart[3]{%
  \expandafter\gdef\csname matins@la@#1\endcsname{#2}%
  \expandafter\gdef\csname matins@en@#1\endcsname{#3}}
\newcount\matins@k
\newcommand\matins@head[1]{% #1 = la or en
  \matins@k=\c@page
  \def\matins@found{}%
  \loop
    \ifcsname matins@#1@\the\matins@k\endcsname
      \edef\matins@found{\the\matins@k}\matins@k=0
    \else
      \advance\matins@k by -1
    \fi
    \ifnum\matins@k>0 \repeat
  \ifx\matins@found\@empty\else\csname matins@#1@\matins@found\endcsname\fi}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[LE]{\small\thepage\hfill\textit{\matins@head{la}}\hfill\phantom{\thepage}}
\fancyhead[RO]{\small\phantom{\thepage}\hfill\textit{\matins@head{en}}\hfill\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}}

% ---- Markup used by the generated content ------------------------------------
\newcommand\rubr[1]{\textcolor{rubric}{#1}}
\newcommand\Rsign{\rubr{℟.}\ }
\newcommand\Vsign{\rubr{℣.}\ }
\newcommand\Star{\rubr{*}}

\RequirePackage{needspace}

% Part and season title pages.
\newcommand\PartTitle[2]{%
  \cleardoublepage\thispagestyle{empty}\markboth{#1}{#2}%
  \vspace*{0.3\textheight}%
  {\centering{\Huge\rubr{#1}}\par\vspace{0.6em}{\Large\itshape #2}\par}%
  \cleardoublepage}
\newcommand\SeasonTitle[2]{%
  \clearpage\thispagestyle{plain}\markboth{#1}{#2}%
  \vspace*{1.2em}%
  {\centering{\LARGE\rubr{#1}}\par\vspace{0.3em}{\large\itshape #2}\par
   \vspace{0.4em}\rubr{\rule{4em}{0.4pt}}\par}\vspace{1em}}

% The heading of one office: Latin title, English title, rank.
\newcommand\Office[3]{%
  \par\needspace{9\baselineskip}\addvspace{1.6em}%
  \protected@write\@auxout{}{\string\OfficeStart{\the\c@page}{#1}{#2}}%
  {\centering{\large\rubr{#1}}\par\vspace{0.15em}{\itshape #2}\par
   \ifx\relax#3\relax\else\vspace{0.1em}{\small\itshape #3}\par\fi}%
  \vspace{0.5em}}

% Inside a column.
\newcommand\LessonHead[1]{\par\addvspace{0.7em}{\centering\rubr{\textsc{#1}}\par}\nopagebreak\vspace{0.1em}}
\newcommand\LessonTitle[1]{{\centering\itshape #1\par}\nopagebreak}
\newcommand\Cite[1]{{\centering\small\rubr{#1}\par}\nopagebreak}
\newcommand\Source[1]{{\centering\small\itshape #1\par}\nopagebreak}
\newcommand\Rubric[1]{{\small\itshape\rubr{#1}\par}}
\newcommand\Note[1]{{\small\itshape\rubr{[#1]}\par}}
\newcommand\RefLine[1]{{\small\itshape\noindent #1\par}}
\newcommand\TeDeum[1]{\par\addvspace{0.3em}{\centering\small\itshape\rubr{#1}\par}}
\newenvironment{Resp}{\par\addvspace{0.4em}\raggedright\hangindent=1em\hangafter=1\noindent}{\par}
% ---- Index of offices (the table of contents, at the back) -------------------
\setcounter{tocdepth}{3}
\newcommand\IndexOfOffices{%
  \renewcommand\contentsname{Index}%
  \begingroup\footnotesize
  \setlength{\parskip}{0pt}%
  \tableofcontents
  \endgroup}
\endinput
